# ──────────────────────────────────────────────────────────────────────────────
# ClawExpress — local environment template
# Copy this file to .env and adjust the values for your setup.
# The .env file is git-ignored and will never be committed.
# ──────────────────────────────────────────────────────────────────────────────

# Disable the built-in authentication system.
#
# Set to "true" if you are self-hosting or running a fork and do not want users
# to sign in before using the app. When disabled:
#   • All actions that normally require a login are unlocked immediately.
#   • No requests are made to the ClawExpress auth API.
#   • A local "Developer" identity is used in place of a real account.
#
# Leave this unset (or set to "false") to keep full auth enabled — this is the
# default for official ClawExpress releases.
VITE_DISABLE_AUTH=false
